# 本地开发保持 true；生产必须改为 false 并设置 AUTH_SECRET。
DEMO_MODE=true
PORT=8787
AUTH_SECRET=
ADMIN_PHONES=
# 仅在演示环境初始化；生产不会自动创建。
DEMO_ACCOUNT=admin
DEMO_PASSWORD=admin123
DEMO_PHONE=13800000001

# DeepSeek 文本模型。填入自己的密钥后启用真实 AI。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_TIMEOUT_MS=60000
AI_RETRIES=1
AI_DAILY_LIMIT=500

# 截图识别：openai 表示 OpenAI 兼容视觉接口，可使用 DeepSeek Flash。
# API Key 与 Base URL 留空时继承 AI 配置，须填写 AI_API_KEY 才可使用。
OCR_PROVIDER=openai
OCR_API_KEY=
OCR_BASE_URL=https://api.deepseek.com/v1
OCR_MODEL=deepseek-flash

# whisper / funasr 指兼容 multipart file + model -> {text} 的转写服务。
# ASR_ENDPOINT 必须是完整的音频转写 URL；未配置时提示手动粘贴逐字稿。
ASR_PROVIDER=disabled
ASR_ENDPOINT=
ASR_API_KEY=
ASR_MODEL=whisper-1

# mock 仅用于演示，不能在生产回显验证码或免费开通会员。
# 真实短信、支付服务尚未接入，不会默默降级为模拟成功。
SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock

FREE_MAX_RESUMES=3
FREE_AI_QUOTA=20
# 可选 SQLite 数据库绝对路径；默认 server/data/app.db
DB_FILE=
