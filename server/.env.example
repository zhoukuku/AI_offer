# ===== AI 大模型配置（OpenAI 兼容接口）=====
# 留空 AI_API_KEY 时，应用运行在 mock 演示模式（不调用真实大模型）

# 大模型 API Key（DeepSeek / 豆包 / OpenAI 等任一兼容服务）
AI_API_KEY=

# OpenAI 兼容 BaseURL：
#   DeepSeek:  https://api.deepseek.com/v1
#   豆包/火山: https://ark.cn-beijing.volces.com/api/v3
#   OpenAI:    https://api.openai.com/v1
#   本地 Ollama: http://localhost:11434/v1
AI_BASE_URL=https://api.deepseek.com/v1

# 模型名（DeepSeek 用 deepseek-chat；豆包按 endpoint 填；OpenAI 用 gpt-4o-mini 等）
AI_MODEL=deepseek-chat

# ===== 服务端口 =====
PORT=8787

# ===== 数据存储层 =====
# sqlite（默认，生产级）| file（旧版 JSON 文件回退）
DB_TYPE=sqlite

# ===== 短信验证码 =====
# mock（默认：验证码随接口返回，本地联调用）| aliyun | tencent
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ===== 支付 =====
# mock（默认：模拟开通会员）| stripe | wechat
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
WECHAT_MCH_ID=
WECHAT_API_KEY=

# ===== OCR（简历 / JD 解析）=====
# mock（默认：内置示例解析文本）| tencent | baidu
OCR_PROVIDER=mock
OCR_SECRET_ID=
OCR_SECRET_KEY=

# ===== 语音转写 ASR =====
# mock（默认：示例逐字稿）| whisper | funasr
ASR_PROVIDER=mock
ASR_ENDPOINT=

# ===== 认证 =====
# token 签名密钥（生产环境务必设置，否则重启后旧登录态失效）
AUTH_SECRET=
# 管理员手机号（逗号分隔）；留空时首个注册用户自动成为管理员
ADMIN_PHONES=
# 演示管理员账号（本地快速体验用）
DEMO_ACCOUNT=admin
DEMO_PASSWORD=admin123
DEMO_PHONE=13800000001

# ===== 免费档限制 =====
FREE_MAX_RESUMES=1
FREE_AI_QUOTA=2
