# ===== AI 大模型配置（OpenAI 兼容接口）=====
# 留空 AI_API_KEY 时，应用运行在 mock 演示模式（不调用真实大模型）

# 大模型 API Key（DeepSeek / 豆包 / OpenAI 等任一兼容服务）
AI_API_KEY=

# OpenAI 兼容 BaseURL：
#   DeepSeek:  https://api.deepseek.com/v1
#   豆包/火山: https://ark.cn-beijing.volces.com/api/v3
#   OpenAI:    https://api.openai.com/v1
#   本地 Ollama: http://localhost:11434/v1
AI_BASE_URL=https://api.deepseek.com/v1

# 模型名（DeepSeek 用 deepseek-chat；豆包按 endpoint 填；OpenAI 用 gpt-4o-mini 等）
AI_MODEL=deepseek-chat

# ===== 服务端口 =====
PORT=8787