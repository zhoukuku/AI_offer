NODE_ENV=production
DEMO_MODE=false
PORT=8787
AUTH_SECRET=
ADMIN_PHONES=
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_RETRIES=1
AI_DAILY_LIMIT=500
FREE_AI_QUOTA=2
PRO_AI_QUOTA=100
AI_USER_DAILY_QUOTA=20
# 每百万 token 美元价，按 Flash 高峰价保守估算；汇率按实际结算修改
AI_INPUT_PRICE_USD=0.3
AI_OUTPUT_PRICE_USD=1.2
AI_CACHE_PRICE_USD=0.006
AI_USD_CNY=7.2
# 当前生产会拒绝模拟支付/短信；拿到商户及短信配置后接入真实服务
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
ASR_PROVIDER=mock
OCR_PROVIDER=openai
OCR_MODEL=deepseek-flash
