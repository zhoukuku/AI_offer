{
  "manifest_version": 3,
  "name": "简历工作台 · 网申助手",
  "version": "1.0.0",
  "description": "一键填充网申表单、记录投递进度、复盘面试，配合「简历工作台」使用。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8787/*", "http://localhost:5173/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "简历工作台 · 网申助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}